# Sao chép thành .env (đã được gitignore) rồi điền giá trị thật, hoặc export các biến này khi chạy.
# Các giá trị mặc định trong file config chỉ dùng cho dev — ở prod phải ghi đè toàn bộ bên dưới.

# Profile đang active: dev (mặc định) | uat | prod
SPRING_PROFILES_ACTIVE=dev

# Bí mật dùng chung giữa các service. BẮT BUỘC phải set ở prod.
APP_SECURITY=change-me-in-env

# Domain thật cho nginx (server_name) — xem docker/nginx/default.conf.template. "_" = catch-all,
# nhận mọi Host header, dùng cho dev/test qua IP hoặc localhost. Có domain thật thì đổi thành nó,
# vd DOMAIN=api.example.com, KHÔNG cần sửa file config nginx.
DOMAIN=_

# Khóa ký JWT (đường dẫn classpath hoặc đường dẫn tuyệt đối mà RsaKeyLoader đọc được).
# Ở prod, hãy mount khóa bên ngoài file jar và trỏ các biến này tới đó.
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_ACCESS_TTL=86400
JWT_REFRESH_TTL=172800

# Domain CDN gốc cho các URL media.
CDN_MEDIA_DOMAIN=https://base-cdn.example

# Lưu trữ file upload (ảnh/video gắn với sản phẩm) — xem FileStorageServiceImpl.
# root-dir: thư mục gốc trên đĩa; file được ghi vào root-dir/images|videos/yyyy/MM/dd/<uuid>.<ext>.
STORAGE_ROOT_DIR=E:/storage
STORAGE_MAX_IMAGE_SIZE=10MB
STORAGE_MAX_VIDEO_SIZE=200MB
STORAGE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
STORAGE_ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/x-msvideo,video/webm
# Upload theo từng đoạn (file lớn) — xem ChunkedUploadServiceImpl.
STORAGE_MIN_CHUNK_SIZE=256KB
STORAGE_MAX_CHUNK_SIZE=20MB
STORAGE_CHUNK_SESSION_TTL=2h
STORAGE_MAX_CHUNK_SESSIONS=1000
# Dọn upload_file mồ côi (complete xong nhưng không bao giờ được gắn vào product) — xem
# OrphanedUploadFileCleanupTask.
STORAGE_ORPHAN_FILE_GRACE_PERIOD=24h
STORAGE_ORPHAN_CLEANUP_INTERVAL=1h
# Bật khi có nginx đứng trước app (docker/nginx/nginx.conf) — GET /v1/files/{id} trả X-Accel-Redirect
# thay vì tự stream byte, để nginx phục vụ file bằng sendfile (nhanh hơn, tốn ít CPU/RAM hơn).
STORAGE_NGINX_ACCEL_REDIRECT_ENABLED=false

# Danh sách origin được phép cho CORS, ngăn cách bằng dấu phẩy. KHÔNG dùng "*" ở prod.
CORS_ALLOWED_ORIGINS=*

# Login v2 qua Keycloak (POST /v2/auth/login) + xác thực song song token Keycloak (JWKS) trên các
# API khác (bên cạnh token RS512 tự ký sẵn có) — xem JwtAuthenticationServiceImpl. Mặc định TẮT.
KEYCLOAK_LOGIN_ENABLED=false
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=base-realm
KEYCLOAK_CLIENT_ID=base-api
# BẮT BUỘC set khi bật — KHÔNG commit giá trị thật vào git.
KEYCLOAK_CLIENT_SECRET=

# RBAC động theo API resource (User/Role/Permission/Menu, xem sql/oracle/rbac.sql) — DynamicPermissionFilter
# + authority PERM_<code>. Mặc định TẮT: hệ thống chỉ còn kiểm tra ROLE_ tĩnh như trước, không đổi hành vi.
RBAC_ENABLED=false

# Giới hạn request ĐẦU VÀO (inbound rate limiting) — tính RIÊNG theo từng IP client.
INBOUND_RATE_LIMIT_ENABLED=true
INBOUND_RATE_LIMIT=1000        # số request tối đa mỗi chu kỳ, cho MỖI IP
INBOUND_RATE_REFRESH=1s        # độ dài chu kỳ cấp lại lượt
INBOUND_RATE_TIMEOUT=0         # thời gian chờ xin lượt; 0 = hết lượt từ chối ngay (429)
# Header lấy IP thật khi sau proxy/LB (vd X-Forwarded-For). Để trống = dùng remoteAddr.
# CHỈ set khi proxy đáng tin tự ghi header, tránh client giả mạo IP.
INBOUND_RATE_IP_HEADER=
# Giới hạn cache limiter theo IP (Caffeine) — chống phình bộ nhớ khi có nhiều IP.
INBOUND_RATE_MAX_CLIENTS=100000  # số IP tối đa giữ trong cache
INBOUND_RATE_CLIENT_TTL=10m      # IP nhàn rỗi quá hạn này thì dọn

# Redis (cache + distributed lock). Mặc định TẮT để base chạy được khi chưa có Redis.
REDIS_ENABLED=false
# --- Standalone ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=3000ms
REDIS_SSL=false
# --- Cluster (điền nodes để chạy cluster; khi đó host/port bị bỏ qua) ---
REDIS_CLUSTER_NODES=
REDIS_CLUSTER_MAX_REDIRECTS=3
# --- Pool Lettuce ---
REDIS_POOL_MAX_ACTIVE=64
REDIS_POOL_MAX_IDLE=32
REDIS_POOL_MIN_IDLE=8
REDIS_POOL_MAX_WAIT=3000ms

# Spring Cloud Consul (config tập trung + discovery). Mặc định TẮT để chạy được khi chưa có Consul.
CONSUL_ENABLED=false
CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_SCHEME=http
# --- Config tập trung (KV) ---
CONSUL_CONFIG_ENABLED=true
CONSUL_CONFIG_FORMAT=YAML
CONSUL_CONFIG_PREFIX=config
CONSUL_CONFIG_DEFAULT_CONTEXT=application
CONSUL_CONFIG_DATA_KEY=data
CONSUL_CONFIG_WATCH_ENABLED=true
# --- Service discovery (đăng ký service) — opt-in riêng ---
CONSUL_DISCOVERY_ENABLED=false
CONSUL_DISCOVERY_REGISTER=true
CONSUL_DISCOVERY_PREFER_IP=true

# ===================== Infra bên thứ 3 (base -full) — TẤT CẢ OPT-IN, mặc định TẮT =====================

# --- MySQL (JPA Hibernate + JdbcTemplate). BẬT: để trống MYSQL_AUTOCONFIGURE_EXCLUDE + điền creds + MYSQL_ENABLED=true ---
MYSQL_ENABLED=false
# Để rỗng để BẬT lại DataSourceAutoConfiguration; mặc định loại trừ nó để TẮT.
MYSQL_AUTOCONFIGURE_EXCLUDE=org.springframework.boot.jdbc.autoconfigure.DataSourceAutoConfiguration
MYSQL_URL=jdbc:mysql://localhost:3306/base?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_POOL_MAX=10
MYSQL_POOL_MIN_IDLE=2
MYSQL_DDL_AUTO=none
MYSQL_DIALECT=org.hibernate.dialect.MySQLDialect
MYSQL_SHOW_SQL=false

# --- Oracle (JPA Hibernate) — dùng cho dev, thay MySQL. Driver: ojdbc11 ---
DB_DWH_URL=jdbc:oracle:thin:@localhost:1521/XE
DB_DWH_USERNAME=dev
DB_DWH_PASSWORD=

# --- MongoDB (Boot 4: prefix spring.mongodb.*). BẬT: MONGODB_ENABLED=true + MONGODB_URI (uri PHẢI kèm tên database) ---
MONGODB_ENABLED=false
MONGODB_URI=mongodb://localhost:27017/base
MONGODB_AUTO_INDEX=false

# --- RabbitMQ (AMQP). BẬT: RABBITMQ_ENABLED=true + host/creds ---
RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
# Cluster: điền nhiều node THAY host/port ở trên.
RABBITMQ_ADDRESSES=

# --- Kafka (cần module spring-boot-kafka). BẬT: KAFKA_ENABLED=true + KAFKA_BOOTSTRAP_SERVERS ---
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=base
KAFKA_CONSUMER_GROUP=base-consumer
KAFKA_AUTO_OFFSET_RESET=earliest
