<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.ringme</groupId>
    <artifactId>base</artifactId>
    <version>0.0.1</version>
    <name>base</name>
    <description>base</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <!-- Spring Cloud release train tương thích Spring Boot 4.1.x -->
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- BOM Spring Cloud: quản version cho các starter spring-cloud-* (vd Consul). -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Spring Boot 4: spring-boot-starter-web đã đổi tên thành spring-boot-starter-webmvc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Spring Boot 4: hỗ trợ MockMvc (@AutoConfigureMockMvc, @WebMvcTest) tách sang module riêng.
             spring-boot-starter-webmvc-test đã bao gồm spring-boot-starter-test + spring-boot-webmvc-test. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>
        <!-- Quan trắc HttpClient5 chính chủ của Apache: thay cho PoolingHttpClientConnectionManagerMetricsBinder
             (Micrometer đã deprecate). Dùng ConnPoolMeters phơi gauge pool (http.client.pool.*). Version do Spring Boot BOM quản. -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5-observation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Spring Boot 4: hỗ trợ test bảo mật + tự áp springSecurity() cho MockMvc (@WithMockUser) nằm ở
             module spring-boot-security-test (SecurityMockMvcAutoConfiguration); kéo theo cả spring-security-test. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers: chạy Redis/Consul THẬT trong Docker để kiểm chứng đường BẬT. Version do Spring Boot BOM quản. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 2.0: các module đổi tên có tiền tố testcontainers- (consul -> testcontainers-consul). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-consul</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers cho 4 infra (full base) — kiểm chứng đường BẬT bằng service THẬT trong Docker. -->
<!--        <dependency>-->
<!--            <groupId>org.testcontainers</groupId>-->
<!--            <artifactId>testcontainers-mysql</artifactId>-->
<!--            <scope>test</scope>-->
<!--        </dependency>-->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mongodb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Cloud Consul: config tập trung (KV) + service discovery. Mặc định TẮT (spring.cloud.consul.enabled=false). -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-consul-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-consul-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.13.0</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.modelmapper</groupId>
            <artifactId>modelmapper</artifactId>
            <version>3.2.6</version>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>
        <!-- Resilience4j cho Spring Boot 4 (starter -spring-boot4). -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <version>2.4.0</version>
        </dependency>
        <!-- Cache có giới hạn dung lượng + tự dọn entry nhàn rỗi (giữ rate limiter theo IP) và làm cache local Caffeine. Version do Spring Boot BOM quản. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!-- Hạ tầng cache của Spring (mang theo spring-context-support: CaffeineCacheManager). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <!-- Redis (Spring Data): tự cấu hình connection factory từ spring.data.redis.* — hỗ trợ cả standalone lẫn cluster. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Pool kết nối Lettuce (cần khi bật spring.data.redis.lettuce.pool.*). Version do Spring Boot BOM quản. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
        <!-- Redisson: distributed lock + RedissonClient (tự dựng từ spring.data.redis.*, single hoặc cluster). -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>4.6.1</version>
        </dependency>

        <!-- ===================== Infra bên thứ 3 (full base) — TẤT CẢ OPT-IN, mặc định TẮT ===================== -->
        <!-- MySQL: dùng CẢ JPA (Hibernate) LẪN JdbcTemplate, đều do spring-boot-starter-data-jpa tự cấu hình. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Driver MySQL. Version do Spring Boot BOM quản. -->
<!--        <dependency>-->
<!--            <groupId>com.mysql</groupId>-->
<!--            <artifactId>mysql-connector-j</artifactId>-->
<!--            <scope>runtime</scope>-->
<!--        </dependency>-->
        <!--        orcle-->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- MongoDB: spring.data.mongodb.* tự cấu hình MongoTemplate (standalone hoặc replica set). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>
        <!-- RabbitMQ (AMQP): spring.rabbitmq.* tự cấu hình RabbitTemplate + listener container. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!-- Kafka: spring.kafka.* tự cấu hình KafkaTemplate + @KafkaListener.
             Spring Boot 4 tách auto-config Kafka sang module spring-boot-kafka (KafkaAutoConfiguration KHÔNG còn
             nằm trong spring-boot-autoconfigure); module này kéo theo spring-kafka. Chỉ thêm spring-kafka thôi sẽ
             có class KafkaTemplate nhưng KHÔNG có bean tự cấu hình. Version do Spring Boot BOM quản. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-kafka</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- JDK 23+ KHÔNG còn tự chạy annotation processor chỉ nằm trên classpath.
                 Phải khai báo Lombok TƯỜNG MINH trong annotationProcessorPaths thì Lombok mới sinh code
                 (@Getter/@Builder/@Log4j2/...). Version do Spring Boot BOM quản (${lombok.version}). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-java-25</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- Fail nhanh, rõ ràng khi build bằng JDK sai. Nhánh này yêu cầu JDK 25 (Spring Boot 4 / Spring Framework 7). -->
                                <requireJavaVersion>
                                    <version>[25,26)</version>
                                    <message>Dự án yêu cầu Java 25. Hãy đặt JAVA_HOME trỏ tới JDK 25 trước khi build.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Test dùng @SpringBootTest nên KHÔNG chạy qua main(); phải khai báo
                         spring.config.name ở đây để import thư mục profiles/<profile>/ nạp đủ file. -->
                    <systemPropertyVariables>
                        <spring.config.name>application,server,web,security,redis,http-client,cache,observability,resilience,mysql,mongodb,rabbitmq,kafka</spring.config.name>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <excludeArtifactIds>spring-boot-devtools</excludeArtifactIds>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                            <mainClass>com.ringme.base.BaseApplication</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
